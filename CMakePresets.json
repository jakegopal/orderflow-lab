{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "ORDERFLOW_WERROR": "ON"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Debug, tests and tools",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release, tests, tools and benchmarks",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ORDERFLOW_BUILD_BENCH": "ON"
      }
    },
    {
      "name": "onnx",
      "inherits": "release",
      "displayName": "Release plus ONNX Runtime and bench_infer (184 MB download)",
      "cacheVariables": {
        "ORDERFLOW_WITH_ONNXRUNTIME": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "ASan + UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ORDERFLOW_SANITIZE": "address,undefined",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O1 -g"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "TSan (cannot share a build with ASan)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ORDERFLOW_SANITIZE": "thread",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O1 -g"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "onnx",
      "configurePreset": "onnx"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
